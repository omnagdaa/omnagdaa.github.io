# ---- Hugo build output ----
# `hugo mod vendor` writes the Hextra source here for inspection. It is a
# local aid, and leaving it in place changes module resolution.
/_vendor/

# gh-pages is built by CI from main; nothing generated belongs in source.
/public/
/resources/
/.hugo_build.lock
hugo_stats.json

# ---- Source media that is NOT shipped ----
# tools/ascii-bg.py renders this into assets/ascii/frames.json (~2 KB gzipped),
# and only the JSON is served. Keep the source video locally, out of git.
/video.mp4
/*.mkv
/*.mov
/*.webm

# ---- Local agent / editor config ----
.claude/
CLAUDE.md
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Secrets & local env ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
.netrc
.npmrc
credentials.json
secrets.y*ml

# ---- Dependencies & virtualenvs ----
node_modules/
.venv/
venv/
env/
__pycache__/
*.py[cod]
.Python
pip-log.txt
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- OS cruft ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
